    {
      "name": "S1 - Weather Service",
      "description": "Weather API implemented as AWS Lambda and exposed through the backend gateway.",
      "item": [
        {
          "name": "Get Current Weather by Coordinates",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has temperature and condition', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('temperature_c');",
                  "    pm.expect(json).to.have.property('temperature_f');",
                  "    pm.expect(json).to.have.property('condition_label');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/weather?lat={{lat}}&lon={{lon}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "weather"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}",
                  "description": "Latitude"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}",
                  "description": "Longitude"
                }
              ]
            },
            "description": "Fetches the current weather for the selected latitude and longitude."
          },
          "response": [
            {
              "name": "200 - Weather for Riyadh",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/weather?lat=24.7136&lon=46.6753",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "weather"
                  ],
                  "query": [
                    {
                      "key": "lat",
                      "value": "24.7136"
                    },
                    {
                      "key": "lon",
                      "value": "46.6753"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"latitude\": 24.7136,\n  \"longitude\": 46.6753,\n  \"temperature_c\": 33.4,\n  \"temperature_f\": 92.12,\n  \"condition_code\": 0,\n  \"condition_label\": \"Clear sky\"\n}"
            },
            {
              "name": "400 - Missing Coordinates",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/weather",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "weather"
                  ]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"error\": \"lat and lon query parameters are required\"\n}"
            }
          ]
        }
      ]
